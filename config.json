{
  "host": "127.0.0.1",
  "port": 8765,
  "open_browser": true,

  "camera": {
    "name_contains": "Iriun",
    "index": -1,
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "rotate": 0
  },

  "detection": {
    "auto_scan": true,
    "pixel_threshold": 0.12,
    "min_note_fraction": 0.02,
    "max_note_fraction": 0.7,
    "still_seconds": 1.2,
    "still_threshold": 0.012,
    "warmup_seconds": 2.5,
    "result_seconds": 4.5,
    "take_note_prompt_seconds": 14
  },

  "reader": {
    "ollama": "http://127.0.0.1:11434",
    "profile": "fast",
    "profiles": {
      "fast": { "model": "gemma3:4b" },
      "accurate": { "model": "gemma3:12b" }
    },
    "options": { "temperature": 0, "num_predict": 256, "num_ctx": 8192 },
    "timeout_seconds": 90,
    "load_timeout_seconds": 600,
    "max_image_side": 1280,
    "tidy_english": true,
    "english_only": false
  },

  "limits": {
    "name_max": 24,
    "message_max": 100
  },

  "privacy": {
    "keep_last_captures": 20
  }
}
